{
  "build:chrome": "ENABLE_MV3=true yarn webpack --build-target=chrome --mode=production",
  "build:firefox": "ENABLE_MV3=false yarn webpack --build-target=firefox --mode=production",
  "build:web": "cd platforms/web && yarn build && cd ../..",
  "build:desktop": "electron-builder -mwl",
  "build:desktop:linux": "electron-builder --linux",
  "build:desktop:mac": "electron-builder --mac",
  "build:desktop:windows": "electron-builder --win",
  "build:android": "cd platforms/mobile/android && ./gradlew assembleRelease && cd ../../..",
  "build:ios": "cd platforms/mobile/ios && xcodebuild -workspace AlsaniaWallet.xcworkspace -scheme AlsaniaWallet -configuration Release archive && cd ../../..",
  "build:all": "bash platforms/build-all.sh",
  "test:chrome": "jest --testPathPattern=platforms/tests/chrome",
  "test:firefox": "jest --testPathPattern=platforms/tests/firefox",
  "test:web": "jest --testPathPattern=platforms/tests/web",
  "test:desktop": "jest --testPathPattern=platforms/tests/desktop",
  "test:android": "cd platforms/mobile/android && ./gradlew test && cd ../../..",
  "test:ios": "cd platforms/mobile/ios && xcodebuild test -workspace AlsaniaWallet.xcworkspace -scheme AlsaniaWallet && cd ../../..",
  "test:e2e:all": "yarn test:e2e:chrome && yarn test:e2e:firefox && yarn test:e2e:web",
  "test:e2e:chrome": "SELENIUM_BROWSER=chrome tsx test/e2e/run-all.ts",
  "test:e2e:firefox": "SELENIUM_BROWSER=firefox tsx test/e2e/run-all.ts",
  "test:e2e:web": "playwright test platforms/tests/e2e/web",
  "dev:chrome": "ENABLE_MV3=true yarn webpack --build-target=chrome --mode=development --watch",
  "dev:firefox": "ENABLE_MV3=false yarn webpack --build-target=firefox --mode=development --watch",
  "dev:web": "cd platforms/web && yarn start && cd ../..",
  "dev:desktop": "concurrently \"yarn dev:web\" \"electron platforms/desktop/main.js\"",
  "dev:android": "cd platforms/mobile && react-native run-android && cd ../..",
  "dev:ios": "cd platforms/mobile && react-native run-ios && cd ../.."
}
